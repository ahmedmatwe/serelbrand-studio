# ============================================================
# YouTube AI Studio — environment variables
# انسخ الملف ده لـ .env واملأ القيم. ملف .env لا يُرفع على git أبداً.
# ============================================================

# --- Safety switches -----------------------------------------
# true = لا اتصالات خارجية مدفوعة ولا رفع حقيقي (الوضع الافتراضي)
DRY_RUN=true
# لا يمكن النشر العلني إلا لو القيمة دي true + موافقة بشرية لكل فيديو
ALLOW_PUBLIC_PUBLISHING=false

# تدقيق تلقائي صارم (مصادر حقيقية + اقتباس حرفي) — المعلومة اللي مش مؤكدة بتتشال من السكريبت
AUTO_VERIFY=false
# الـAutopilot يوافق وينشر لوحده لو الفيديو عدّى كل الفحوصات (من غير مراجعة بشرية)
AUTO_APPROVE=false

# --- Providers ------------------------------------------------
# كل المزودات بتبقى mock تلقائياً طول ما DRY_RUN=true.
# عشان تستخدم Gemini المجاني: DRY_RUN=false و LLM_PROVIDER=gemini (والرفع يفضل mock).
LLM_PROVIDER=mock          # mock | gemini
TTS_PROVIDER=gemini        # mock | macos | gemini  (gemini = صوت طبيعي مجاني، ولو الحد خلص يرجع لماجد)
IMAGE_PROVIDER=mock
YOUTUBE_PROVIDER=mock
TRENDS_PROVIDER=mock

# --- Google Gemini (مجاني من Google AI Studio) ----------------
# مفتاح مجاني بدون كارت: https://aistudio.google.com/apikey
# ملاحظة: في الـfree tier، Google ممكن تستخدم المحتوى لتحسين منتجاتها.
GEMINI_API_KEY=
# قائمة بالترتيب: لو موديل مشغول بينتقل للي بعده
GEMINI_MODEL_WRITING=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-3.5-flash-lite
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview
GEMINI_FREE_TIER=true
LLM_RPM=8

# --- Voices ---------------------------------------------------
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
MACOS_VOICE=Majed

# --- Anthropic (Claude) — اختياري/مدفوع، غير مستخدم حالياً -----
ANTHROPIC_API_KEY=
LLM_MODEL_WRITING=claude-sonnet-5-5
LLM_MODEL_LIGHT=claude-haiku-5-5

# --- Text-to-speech ------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock media (مجاني) --------------------------------------
# Pixabay: STOCK_PROVIDER=pixabay + مفتاح مجاني من https://pixabay.com/api/docs/ (بعد تسجيل الدخول)
# Pexels:  STOCK_PROVIDER=pexels  (إصدار مفاتيح جديدة متوقف حالياً)
STOCK_PROVIDER=mock        # mock | pixabay | pexels
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube (OAuth 2.0 desktop client) ----------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok Content Posting API (optional) -------------------
# OAuth user access token with video.publish (direct post) or video.upload (draft) scope.
TIKTOK_ACCESS_TOKEN=
# Unaudited clients are restricted by TikTok; SELF_ONLY is the safe default.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Storage -------------------------------------------------
DATABASE_URL=sqlite:./data/studio.db

# --- Budget --------------------------------------------------
MONTHLY_BUDGET_USD=100

# --- Logging: debug | info | warn | error --------------------
LOG_LEVEL=info
